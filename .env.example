# Copy to .env for local runs. Never commit .env.

# Gmail (same app password as the profit dashboard email)
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=paste-16-character-app-password
SUPPORT_ADDRESS=you+support@gmail.com

# Claude API (console.anthropic.com)
ANTHROPIC_API_KEY=paste-api-key
ANTHROPIC_MODEL=claude-haiku-5-5

# Shopify (same app as the other projects)
SHOPIFY_STORE=storeopsco-lab.myshopify.com
SHOPIFY_CLIENT_ID=paste-client-id
SHOPIFY_CLIENT_SECRET=paste-client-secret

# Notion internal integration (notion.so/my-integrations)
NOTION_TOKEN=paste-notion-secret
NOTION_TICKETS_DB=bf0b1d67546d47baa87316ce10134922
NOTION_TEMPLATES_DB=paste-your-response-bank-database-id

# Optional
SLACK_WEBHOOK_URL=paste-slack-webhook
SHOP_NAME=StoreOpsCo Lab
